{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "autumn-gallery",

  "pages_build_output_dir": "./public",

  "compatibility_date": "2026-09-17",

  "r2_buckets": [
    {
      "binding": "WOOOK",
      "bucket_name": "woook"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  "cache": {
    "enabled": true
  }
}
